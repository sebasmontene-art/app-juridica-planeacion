language = "javascript"
entrypoint = "src/server.js"
modules = ["nodejs-20"]
run = "sh -lc 'echo Node: $(node --version); echo NPM: $(npm --version || true); node src/server.js'"

[nix]
channel = "stable-23_11"

[deployment]
run = "sh -lc 'echo Node: $(node --version); echo NPM: $(npm --version || true); node src/server.js'"
deploymentTarget = "autoscale"
ignorePorts = false
